{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "example.json.Order",
  "description": "An order, as the shop writes it.",
  "type": "object",
  "properties": {
    "kind": { "const": "order" },
    "id": { "type": "string", "format": "uuid", "description": "Who knows the order by it." },
    "placed": { "type": "string", "format": "date-time" },
    "day": { "type": "string", "format": "date", "default": "2024-01-02" },
    "opens": { "type": "string", "format": "time", "default": "09:00:00+01:00" },
    "status": { "enum": ["new", "in-progress", "paid", "values"], "default": "new" },
    "lines": { "type": "array", "items": { "$ref": "#/definitions/Line" } },
    "payment": { "oneOf": [{ "$ref": "#/definitions/Cash" }, { "$ref": "#/definitions/Card" }] },
    "refund": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/Cash" }] },
    "note": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" }, "default": ["a", "b"] },
    "counts": { "type": "object", "additionalProperties": { "type": "integer" }, "default": { "x": 1 } },
    "metadata": {},
    "ratio": { "type": "number", "default": 0.5, "minimum": 0 },
    "blob": { "type": "string", "contentEncoding": "base64", "default": "AP8=" },
    "first-name": { "type": "string", "default": "say \"hi\"\n" },
    "type": { "type": "string", "default": "keyword" },
    "copy": { "type": "integer", "default": 2 },
    "code": { "type": ["string", "integer"] },
    "measure": { "anyOf": [{ "type": "integer" }, { "type": "number" }] },
    "size": {
      "oneOf": [
        { "title": "Small", "type": "object", "properties": { "n": { "type": "integer" } }, "required": ["n"] },
        { "title": "Large", "type": "object", "properties": { "n": { "type": "integer" }, "m": { "type": "integer" } }, "required": ["n"] }
      ]
    },
    "shipping": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string", "default": "Rome" },
        "exact": { "oneOf": [{ "type": "integer" }, { "type": "number" }] }
      },
      "required": ["street"],
      "default": { "street": "Via Roma 1" }
    }
  },
  "required": ["kind", "id", "placed", "lines", "payment", "note", "shipping"],
  "definitions": {
    "Line": {
      "type": "object",
      "properties": { "sku": { "type": "string" }, "quantity": { "type": "integer", "default": 1 } },
      "required": ["sku"]
    },
    "Cash": {
      "type": "object",
      "properties": { "amount": { "type": "number" } },
      "required": ["amount"]
    },
    "Card": {
      "type": "object",
      "properties": { "amount": { "type": "number" }, "last4": { "type": "string" } },
      "required": ["amount", "last4"]
    }
  }
}
